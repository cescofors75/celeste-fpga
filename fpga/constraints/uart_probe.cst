// UART/clock/reset from https://github.com/sipeed/TangNano-20K-example/blob/main/uart/src/top.cst
IO_LOC "clk27" 4;
IO_PORT "clk27" IO_TYPE=LVCMOS33;
IO_LOC "reset_button" 88;
IO_PORT "reset_button" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "uart_rx" 70;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33;
IO_LOC "uart_tx" 69;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33;
// LED pin from inherited CELESTE av.cst.
IO_LOC "led" 15;
IO_PORT "led" IO_TYPE=LVCMOS33 DRIVE=4;
